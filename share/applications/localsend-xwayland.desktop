# 派生自 /usr/share/applications/localsend.desktop（localsend 1.18.2-2），只改了 Exec：
# 强制走 XWayland。原因：2026-11-20 mesa 26.2.6 → 26.3.1 后，GTK3 在 Wayland 下给 Flutter
# 选 EGL config 失败（"Failed to create OpenGL context: No available configurations for the
# given pixel format"），窗口画不出来。用旧 mesa 对照能正常起，确认是 mesa 回归。
# 原条目在 ~/.config/elephant/desktopapplications.toml 里 blacklist 掉了。
# mesa 修好后：删本文件 + 删那条 blacklist 即可，见 cachyOS-config docs/07。
[Desktop Entry]
Type=Application
Name=LocalSend
Comment=An open source cross-platform alternative to AirDrop
Exec=env GDK_BACKEND=x11 /usr/bin/localsend
Icon=localsend
Terminal=false
Categories=Utility;Network;
StartupWMClass=Org.localsend.localsend_app

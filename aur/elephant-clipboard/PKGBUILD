# 本地改版：剪贴板搜索改成「不分大小写子串 + 空格分词 AND + 按时间排序」。
# 原因与升级注意事项见 ~/cachyOS-config/aur/README.md「elephant-clipboard」一节。
# 补丁的源头：github.com/numb747/elephant 的 clipboard-substring-search 分支（本地克隆 ~/Projects/elephant）。
# pkgrel 1.1 = 上游 2.22.1-1 + 本地补丁；上游出新版时 yay 会用未打补丁的版本覆盖，要回来重打。
# Maintainer: Andrej Benz <hello[at]benz[dot]dev>

pkgname=elephant-clipboard
pkgver=2.22.1
pkgrel=1.1
pkgdesc='clipboard provider for elephant'
url='https://github.com/abenz1267/elephant'
arch=('x86_64' 'aarch64')
license=('GPL')
depends=('wl-clipboard' 'imagemagick')
makedepends=('go')
conflicts=('elephant-clipboard')
provides=('elephant-clipboard')
source=("${url}/archive/refs/tags/v${pkgver}.tar.gz"
        'clipboard-substring-search.patch')
sha256sums=('3d1d0d4c55ae531fa3f06406b96504b5165a0d7b53523d1f8351d9d93e457f44'
            '5b9145dacc6716c4a82de9911b5313f8e493791f4a66f4d34a9984aef92af2bb')

prepare() {
    cd elephant-${pkgver}
    patch -Np1 -i "${srcdir}/clipboard-substring-search.patch"
}

build() {
    cd elephant-${pkgver}/internal/providers/clipboard
    go build -ldflags="-s -w" -buildvcs=false -buildmode=plugin -trimpath
}

package() {
    cd elephant-${pkgver}/internal/providers/clipboard
    install -Dm 755 clipboard.so -t "${pkgdir}/usr/lib/elephant"

    cd ../../../
    install -Dm 644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

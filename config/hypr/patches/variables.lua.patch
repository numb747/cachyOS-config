--- /etc/skel/.config/hypr/config/variables.lua	2026-09-13 17:48:20.000000000 +0800
+++ /home/david/cachyOS-config/config/hypr/config/variables.lua	2026-11-04 10:38:16.592886049 +0800
@@ -3,7 +3,9 @@
 TERMINAL     = "kitty"
 FILE_MANAGER = "dolphin"
 BROWSER      = "firefox"
-EDITOR       = "gnome-text-editor --new-window"
+-- ★ 原为 gnome-text-editor --new-window；2026-11-04 换成 Kate（gnome 那个只是被
+--   cachyos-hypr-noctalia 依赖拉进来的）。-n = 新开实例窗口，对应原来的 --new-window。
+EDITOR       = "kate -n"
 CALCULATOR   = "gnome-calculator"
 
 -- Monitors
@@ -13,4 +15,9 @@
 PRIMARY_MONITOR = MONITOR1
 
 -- Workspaces
-NUM_WPM = 3 -- Number of workspaces per monitor (Max 10)
+-- ★ 本配置为纯动态工作区（config/workspaces.lua 不定义 persistent 规则），
+--   所以这个值不再决定“有几个桌面”，只决定生成多少个【按位置跳转】的键位：
+--     SUPER + CTRL  + 1..N        跳到本显示器第 N 个已存在的工作区
+--     SUPER + SHIFT + CTRL + 1..N 把当前窗口丢到第 N 个
+--   绑满 9 个没有代价：位置不存在时按下即空操作。
+NUM_WPM = 9 -- Number of position-based workspace keybinds (Max 10)
